# MySQL 配置
MYSQL_ROOT_PASSWORD=replace-with-mysql-root-password
MYSQL_DATABASE=blog
MYSQL_USER=bloguser
MYSQL_PASSWORD=replace-with-mysql-password

# Redis 配置；未启用密码时保持为空
REDIS_PASSWORD=

# MongoDB 配置
MONGODB_ROOT_USERNAME=bloguser
MONGODB_ROOT_PASSWORD=replace-with-mongodb-password
MONGODB_DATABASE=blog

# JWT 配置
JWT_SECRET=replace-with-at-least-32-byte-jwt-secret
OPENJWT_SECRET=replace-with-at-least-32-byte-open-jwt-secret

# 三方合作方配置
PARTNER_A_ACCESS_KEY_ID=replace-with-partner-access-key-id
PARTNER_A_SECRET_KEY=replace-with-partner-secret-key

# OSS 配置
OSS_ACCESS_KEY_ID=replace-with-oss-access-key-id
OSS_SECRET_ACCESS_KEY=replace-with-oss-secret-access-key

# Canal 配置
CANAL_DB_USERNAME=canal
CANAL_DB_PASSWORD=replace-with-canal-password
CANAL_SERVER_USERNAME=
CANAL_SERVER_PASSWORD=

# Elasticsearch 配置；Compose 本地开发关闭认证，Kubernetes 模板使用以下凭证
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace-with-elasticsearch-password
